{
  "name": "animeeh",
  "version": "0.1.2",
  "description": "ANIMEEH — track and rank every anime you watch, episode by episode.",
  "main": "./out/main/index.js",
  "author": "Axel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:offline": "npm run build && node scripts/smoke-offline.mjs",
    "smoke:update": "node scripts/smoke-update.mjs",
    "smoke:update:live": "node scripts/smoke-update-live.mjs",
    "check:franchise": "node scripts/check-franchise.mjs",
    "release": "node scripts/release.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
