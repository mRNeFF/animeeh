{
  "name": "animeeh",
  "version": "0.3.0",
  "description": "ANIMEEH — track and rank every anime you watch, episode by episode.",
  "main": "./out/main/index.js",
  "author": "Axel",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:offline": "npm run build && node scripts/smoke-offline.mjs",
    "smoke:seed": "npm run build && node scripts/smoke-seed.mjs",
    "smoke:episodes": "npm run build && node scripts/smoke-episodes.mjs",
    "smoke:covers": "npm run build && node scripts/smoke-covers.mjs",
    "smoke:seasons": "npm run build && node scripts/smoke-seasons.mjs",
    "check:episodes": "node scripts/check-episodes.mjs",
    "inspect": "node scripts/inspect-anime.mjs",
    "check:numbering": "node scripts/check-episode-numbering.mjs",
    "diagnose:episodes": "node scripts/diagnose-episode-names.mjs",
    "smoke:films": "npm run build && node scripts/smoke-films.mjs",
    "smoke:bugfix": "npm run build && node scripts/smoke-bugfix.mjs",
    "smoke:stats": "npm run build && node scripts/smoke-stats.mjs",
    "audit:translations": "node scripts/audit-translations.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "seed": "node scripts/build-seed.mjs",
    "smoke:update": "node scripts/smoke-update.mjs",
    "smoke:update:live": "node scripts/smoke-update-live.mjs",
    "check:franchise": "node scripts/check-franchise.mjs",
    "release": "node scripts/release.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
